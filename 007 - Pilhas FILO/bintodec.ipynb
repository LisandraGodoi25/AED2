    "    \n",
    "    startvalue = decvalue\n",
    "    binnum = []\n",
    "\n",
    "    while startvalue > 0:\n",
    "        toadd = startvalue % 2\n",
    "        print(f\"Add to the list {toadd}\")\n",
    "        binnum.append(toadd)\n",
    "\n",
    "        startvalue = startvalue // 2"
